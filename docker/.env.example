# Docker Environment Variables Example
# Copy this file to .env and customize for your environment

# ============================================
# Python/Application Settings
# ============================================

# Disable Python bytecode generation
PYTHONDONTWRITEBYTECODE=1

# Unbuffered output (see logs in real-time)
PYTHONUNBUFFERED=1

# Python path
PYTHONPATH=/app

# ============================================
# Application Configuration
# ============================================

# Application name
APP_NAME=chklst

# Debug mode (set to 'true' for development, 'false' for production)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================
# Backend Configuration (FastAPI)
# ============================================

# Server host (0.0.0.0 for Docker)
UVICORN_HOST=0.0.0.0

# Server port
UVICORN_PORT=8000

# Number of worker processes
UVICORN_WORKERS=4

# Enable reload on code changes (development only)
UVICORN_RELOAD=false

# ============================================
# Frontend Configuration (Vue.js/Vite)
# ============================================

# API URL for frontend
VITE_API_URL=http://localhost:8000

# Frontend environment
VITE_ENVIRONMENT=production

# ============================================
# Database Configuration
# ============================================

# Database path
DATABASE_URL=sqlite:///./data/chklst.db

# ============================================
# Feature Flags
# ============================================

# Enable/disable authentication
ENABLE_AUTH=true

# Enable/disable WebSocket support
ENABLE_WEBSOCKET=true

# Enable/disable migration on startup
AUTO_MIGRATE=true

# ============================================
# Deployment Options
# ============================================

# Maximum upload file size (in bytes)
MAX_UPLOAD_SIZE=104857600  # 100MB

# Session timeout (in seconds)
SESSION_TIMEOUT=3600

# CORS allowed origins (comma-separated)
CORS_ORIGINS=*

# ============================================
# Email Configuration (Optional)
# ============================================

# SMTP server
SMTP_SERVER=smtp.gmail.com

# SMTP port
SMTP_PORT=587

# SMTP username
SMTP_USER=your-email@example.com

# SMTP password
SMTP_PASSWORD=your-password

# From address
EMAIL_FROM=noreply@example.com

# ============================================
# Backup Configuration
# ============================================

# Enable automatic backups
BACKUP_ENABLED=false

# Backup interval (in hours)
BACKUP_INTERVAL=24

# Backup directory
BACKUP_DIR=/app/backups

# ============================================
# Monitoring & Logging
# ============================================

# Enable metrics collection
METRICS_ENABLED=false

# Metrics port
METRICS_PORT=9090

# Log to file
LOG_TO_FILE=false

# Log file path
LOG_FILE=/app/logs/app.log
